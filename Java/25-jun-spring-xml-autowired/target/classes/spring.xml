	<bean name="audio" class="com.harman.demo.model.Jbl">
	</bean>
	
	<bean name="sony" class="com.harman.demo.model.Sony">
	</bean>
	
	<bean name="car" class="com.harman.demo.model.Car" autowire="byName">
	</bean>
</beans>
